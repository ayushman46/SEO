# Public base URL of the site (canonical URLs, sitemap). e.g. https://seenhq.com
NEXT_PUBLIC_SITE_URL=
# Postgres connection string (Neon free tier recommended; Supabase pooled URL also works)
DATABASE_URL=
# Random string, min 32 chars, used to seal audit results behind the email gate (openssl rand -base64 48)
AUDIT_SEAL_SECRET=
# Random string, min 16 chars, used to hash visitor IPs for rate limiting / abuse tracking
IP_HASH_SALT=
# Password for /admin (user: admin), min 12 chars. If empty or shorter, /admin returns 404.
ADMIN_PASSWORD=
# Optional: Google PageSpeed Insights API key (raises quota for Core Web Vitals checks)
PAGESPEED_API_KEY=
# Optional: Resend API key for email notifications (console logging when empty)
RESEND_API_KEY=
# Optional: where contact/lead notifications are sent
CONTACT_NOTIFY_EMAIL=
# Optional: verified sender, e.g. "seenhq <hello@seenhq.com>"
MAIL_FROM=
