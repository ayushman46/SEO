diff --git a/src/app/globals.css b/src/app/globals.css
index 53ce923..45e2b47 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -595,3 +595,43 @@ html.lenis {
 }
 
 
+
+/* Home sections below the first screen (R6 finding 1): the browser skips style, layout
+   and paint for them until they near the viewport, so the first layout pass covers only
+   the hero and the engine strip. The placeholder heights are the measured section
+   heights per layout band (set inline by LazySection), and `auto` keeps the real height
+   once a section has rendered, so the page height and in-page anchors do not jump. */
+.cv-auto {
+  content-visibility: auto;
+  contain-intrinsic-size: auto var(--cv-base);
+}
+@media (min-width: 400px) {
+  .cv-auto {
+    contain-intrinsic-size: auto var(--cv-sm);
+  }
+}
+@media (min-width: 768px) {
+  .cv-auto {
+    contain-intrinsic-size: auto var(--cv-md);
+  }
+}
+@media (min-width: 1024px) {
+  .cv-auto {
+    contain-intrinsic-size: auto var(--cv-lg);
+  }
+}
+@media (min-width: 1280px) {
+  .cv-auto {
+    contain-intrinsic-size: auto var(--cv-xl);
+  }
+}
+@media (min-width: 1600px) {
+  .cv-auto {
+    contain-intrinsic-size: auto var(--cv-2xl);
+  }
+}
+@media print {
+  .cv-auto {
+    content-visibility: visible;
+  }
+}
